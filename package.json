{
  "name": "code-shoebox",
  "version": "1.0.36-c",
  "type": "module",
  "description": "A client-side code playground component for React featuring CodeMirror 6 and sandboxed execution.",
  "main": "export.cjs",
  "module": "export.js",
  "types": "export.d.ts",
  "exports": {
    ".": {
      "types": "./export.d.ts",
      "import": "./export.js",
      "require": "./export.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@emmetio/codemirror6-plugin": "^0.4.1",
    "@monaco-editor/react": "^4.6.0",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/monaco": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "codemirror": "^6.0.2",
    "emmet-monaco-es": "^5.7.0",
    "lucide-react": "^0.469.0"
  },
  "keywords": [
    "react",
    "code-editor",
    "sandbox",
    "monaco",
    "playground",
    "p5.js"
  ],
  "author": "Robert McCreary Mannino",
  "repository": {
    "type": "git",
    "url": "https://github.com/rmccrear/code-shoebox.git"
  },
  "homepage": "https://github.com/rmccrear/code-shoebox#readme",
  "license": "MIT",
  "overrides": {
    "dompurify": "^3.4.0"
  },
  "style": "styles.css"
}