{
  "name": "code-shoebox",
  "version": "1.0.37-c",
  "type": "module",
  "description": "A client-side code playground component for React featuring CodeMirror 6 and sandboxed execution.",
  "main": "dist/export.cjs",
  "module": "dist/export.js",
  "types": "dist/export.d.ts",
  "exports": {
    ".": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js",
      "require": "./dist/export.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup export.ts --format cjs,esm --dts --clean && node scripts/build-styles.mjs",
    "test:html-stylesheets": "node scripts/check-html-stylesheets.mjs",
    "test:styles": "node scripts/check-style-isolation.mjs",
    "compare:editors": "node scripts/compare-editors.mjs",
    "build:demo": "vite build --outDir .demo-site",
    "prepublishOnly": "npm run build",
    "publish:dist": "npm run build && node scripts/prepare-dist.js && npx gh-pages -d dist -b dist",
    "publish:demo": "node scripts/publish-demo.js",
    "release": "node scripts/release.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@emmetio/codemirror6-plugin": "^0.4.1",
    "@monaco-editor/react": "^4.6.0",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/monaco": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "codemirror": "^6.0.2",
    "emmet-monaco-es": "^5.7.0",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "1.56.1",
    "postcss": "^8.5.15",
    "postcss-selector-parser": "^6.1.2",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "react",
    "code-editor",
    "sandbox",
    "monaco",
    "playground",
    "p5.js"
  ],
  "author": "Robert McCreary Mannino",
  "repository": {
    "type": "git",
    "url": "https://github.com/rmccrear/code-shoebox.git"
  },
  "homepage": "https://github.com/rmccrear/code-shoebox#readme",
  "license": "MIT",
  "overrides": {
    "dompurify": "^3.4.0"
  }
}
